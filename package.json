{
  "name": "mirai-suite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean:next": "node scripts/clean-next.mjs",
    "dev": "node scripts/next-preflight.mjs --port 3000 -- next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "npx tsx src/scripts/seed.ts",
    "seed:categories": "npx tsx src/scripts/seed-categories.ts",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "security:audit": "node src/scripts/security-audit.mjs",
    "security:check": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix && npm audit fix --force"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.33.0",
    "@payloadcms/next": "^3.33.0",
    "@payloadcms/richtext-lexical": "^3.33.0",
    "@payloadcms/ui": "^3.82.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.9.0",
    "lucide-react": "^0.474.0",
    "next": "~15.4.11",
    "payload": "^3.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
