# =============================================================================
# MIRAI SUITE - LANDING PORTAL
# Environment variables template
# =============================================================================
# Copy this file to .env only when you need custom local values.
# Basic local development can run without .env by using safe development
# defaults from src/env/payload-env.ts.
#
# Never commit .env.
# Values prefixed with NEXT_PUBLIC_ are visible in the browser.
# Values without NEXT_PUBLIC_ are server/build only.
# =============================================================================


# -----------------------------------------------------------------------------
# GATE (acceso previo a la landing)
# -----------------------------------------------------------------------------

# Si se definen ambas variables, se activa el login gate antes de la landing.
# Déjalas vacías para desactivar el gate en desarrollo.
GATE_EMAIL=
GATE_PASSWORD=


# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------

# Runtime environment: development | staging | production
NODE_ENV=development

# Force strict validation of secrets and database settings.
# Set to true in CI/staging/production if your platform does not expose markers
# such as CI, RAILWAY_ENVIRONMENT, VERCEL_ENV, or VERCEL.
REQUIRE_PRODUCTION_SECRETS=false

# Base site URL without trailing slash.
PUBLIC_SITE_URL=http://localhost:3000


# =============================================================================
# PAYLOAD CMS
# =============================================================================

# JWT/session secret for Payload.
# LOCAL: optional. If omitted, a local-only fallback is used.
# STAGING/PRODUCTION: required. Use a strong random value.
PAYLOAD_SECRET=mirai-suite-dev-secret-change-in-production

# Database connection string.
# LOCAL: optional. If omitted, file:./payload.db is used.
# STAGING/PRODUCTION: required. Use PostgreSQL or another managed database.
# Railway: configure DATABASE_URI in the Railway dashboard.
DATABASE_URI=file:./payload.db

# Visits tracking is optional. Local default is disabled.
ENABLE_VISITS_TRACKING=false
NEXT_PUBLIC_ENABLE_VISITS_TRACKING=false
VISITS_BASELINE_ISO=2026-04-17T16:24:21.3574771+02:00
NEXT_PUBLIC_VISITS_BASELINE_ISO=2026-04-17T16:24:21.3574771+02:00


# -----------------------------------------------------------------------------
# INTERNAL TOOL URLS
# -----------------------------------------------------------------------------

PUBLIC_URL_MIRAI_CORE_TOOLS=
PUBLIC_URL_EXTRANET_DATA_READER=
PUBLIC_URL_FORWARDER_URL_CREATOR=
PUBLIC_URL_CLAMP_CALCULATOR=
PUBLIC_URL_CSS_SORTER=
PUBLIC_URL_ELEMENTOR_FORM_GENERATOR=
PUBLIC_URL_POPUP_IMAGE_GENERATOR=
PUBLIC_URL_XML_TO_ELEMENTOR=
PUBLIC_URL_AUDIT_URL_CHECKER=
PUBLIC_URL_REDIRECTION_ASSISTANT=
PUBLIC_URL_IMAGE_RESIZER=


# -----------------------------------------------------------------------------
# ANALYTICS (optional)
# -----------------------------------------------------------------------------

PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_PLAUSIBLE_DOMAIN=


# -----------------------------------------------------------------------------
# FUTURE SERVER API INTEGRATIONS (optional)
# -----------------------------------------------------------------------------

API_BASE_URL=
API_SECRET_KEY=
API_TIMEOUT_MS=5000


# -----------------------------------------------------------------------------
# FUTURE AUTH INTEGRATIONS (optional)
# -----------------------------------------------------------------------------

AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_DOMAIN=
JWT_SECRET=


# -----------------------------------------------------------------------------
# FUTURE HEADLESS CMS INTEGRATIONS (optional)
# -----------------------------------------------------------------------------

SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=2024-01-01
SANITY_TOKEN=

CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=


# -----------------------------------------------------------------------------
# DEPLOYMENT TOKENS (optional, configure in provider dashboards)
# -----------------------------------------------------------------------------

# NETLIFY_AUTH_TOKEN=
# VERCEL_TOKEN=
